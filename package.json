    "nprogress": "^0.2.0",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vant": "^4.10.0",
    "vconsole": "^3.15.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.2.0",
    "@types/node": "^26.1.2",
    "@types/nprogress": "^0.2.3",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-legacy": "^8.2.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
