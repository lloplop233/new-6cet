{
  "name": "cet6-vocab",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "六级词汇背记工具（移动端 H5）",
  "engines": {
    "node": ">=22.23.0",
    "pnpm": ">=11.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build:dev": "vue-tsc --noEmit && vite build --mode development",
    "build:pro": "vue-tsc --noEmit && vite build --mode production",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:pro",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@unhead/vue": "3.2.3",
    "@vant/touch-emulator": "^1.5.0",
